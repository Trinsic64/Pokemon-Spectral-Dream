{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.visual.shake_camera_cue",
    "name":  "Shake Camera Cue",
    "description":  "Play cue and shake camera with configurable intensity.",
    "category":  "VisualAudio",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "fanfare",
                           "label":  "Cue Fanfare",
                           "type":  "sound_symbol",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  "SEQ_SE_DP_KI_GASYAN"
                       },
                       {
                           "id":  "xMagnitude",
                           "label":  "X Magnitude",
                           "type":  "u16",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "yMagnitude",
                           "label":  "Y Magnitude",
                           "type":  "u16",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  2,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "count",
                           "label":  "Shake Count",
                           "type":  "u16",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  10,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "time",
                           "label":  "Shake Time",
                           "type":  "u16",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  5,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${fanfare}",
                                 "${xMagnitude}",
                                 "${yMagnitude}",
                                 "${count}",
                                 "${time}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "PlayFanfare",
                                                            "GenericScriptCommand"
                                                        ],
                              "notes":  "Impact event effect pattern."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "PlayFanfare ${fanfare}",
                                                                    "command":  "PlayFanfare"
                                                                },
                                                                {
                                                                    "line":  "ShakeCamera ${xMagnitude} ${yMagnitude} ${count} ${time}",
                                                                    "command":  "ShakeCamera"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Test shake settings in-game to avoid excess camera motion."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
