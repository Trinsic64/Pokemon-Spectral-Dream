{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.visual.play_sound_wait",
    "name":  "Play Sound And Wait",
    "description":  "Play a sound ID and wait until playback is complete.",
    "category":  "VisualAudio",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "soundId",
                           "label":  "Sound ID",
                           "type":  "sound_id",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${soundId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "PlaySound",
                                                            "WaitSound"
                                                        ],
                              "notes":  "Simple audio gate snippet."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "PlaySound ${soundId}",
                                                                    "command":  "PlaySound"
                                                                },
                                                                {
                                                                    "line":  "WaitSound",
                                                                    "command":  "WaitSound"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Prefer PlayFanfare for confirm cues; PlaySound for direct IDs."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
