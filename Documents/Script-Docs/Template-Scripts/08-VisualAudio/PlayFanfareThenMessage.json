{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.visual.fanfare_message",
    "name":  "Play Fanfare Then Message",
    "description":  "Play fanfare then show message line.",
    "category":  "VisualAudio",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "fanfare",
                           "label":  "Fanfare",
                           "type":  "sound_symbol",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  "SEQ_SE_CONFIRM"
                       },
                       {
                           "id":  "messageId",
                           "label":  "Message ID",
                           "type":  "text_id",
                           "scrcmdType":  "u8",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  255
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${fanfare}",
                                 "${messageId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "GreetingBasic",
                                                            "Message"
                                                        ],
                              "notes":  "Common acknowledgment pattern."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "PlayFanfare ${fanfare}",
                                                                    "command":  "PlayFanfare"
                                                                },
                                                                {
                                                                    "line":  "Message ${messageId}",
                                                                    "command":  "Message"
                                                                },
                                                                {
                                                                    "line":  "WaitButton",
                                                                    "command":  "WaitButton"
                                                                },
                                                                {
                                                                    "line":  "CloseMessage",
                                                                    "command":  "CloseMessage"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Keep message brief when used as inline confirmation."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
