{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.visual.fade_out_in",
    "name":  "Fade Out In",
    "description":  "Fade to black and fade back in with waits.",
    "category":  "VisualAudio",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "frameCount",
                           "label":  "Frame Count",
                           "type":  "u16",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  6,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "duration",
                           "label":  "Duration",
                           "type":  "u16",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${frameCount}",
                                 "${duration}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "FadeOut",
                                                            "FadeIn"
                                                        ],
                              "notes":  "Canonical transition wrapper."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "FadeScreen ${frameCount} ${duration} 0 0",
                                                                    "command":  "FadeScreen"
                                                                },
                                                                {
                                                                    "line":  "WaitFadeScreen",
                                                                    "command":  "WaitFadeScreen"
                                                                },
                                                                {
                                                                    "line":  "FadeScreen ${frameCount} ${duration} 1 0",
                                                                    "command":  "FadeScreen"
                                                                },
                                                                {
                                                                    "line":  "WaitFadeScreen",
                                                                    "command":  "WaitFadeScreen"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Use color 0 unless intentional alternate fade color."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
