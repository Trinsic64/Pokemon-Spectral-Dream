{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.pokemon.heal_party_interaction",
    "name":  "Heal Party Interaction",
    "description":  "Play heal cue, heal party, and show confirmation dialogue.",
    "category":  "Pokemon",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "healCue",
                           "label":  "Heal Cue Sound",
                           "type":  "sound_symbol",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  "SEQ_ME_ASA"
                       },
                       {
                           "id":  "messageId",
                           "label":  "Message ID",
                           "type":  "text_id",
                           "scrcmdType":  "u8",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  255
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${healCue}",
                                 "${messageId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "PlaySound",
                                                            "WaitSound",
                                                            "Message"
                                                        ],
                              "notes":  "Compact healing interaction for scripted heal points."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "PlaySound ${healCue}",
                                                                    "command":  "PlaySound"
                                                                },
                                                                {
                                                                    "line":  "WaitSound",
                                                                    "command":  "WaitSound"
                                                                },
                                                                {
                                                                    "line":  "HealPokemon",
                                                                    "command":  "HealPokemon"
                                                                },
                                                                {
                                                                    "line":  "Message ${messageId}",
                                                                    "command":  "Message"
                                                                },
                                                                {
                                                                    "line":  "WaitButton",
                                                                    "command":  "WaitButton"
                                                                },
                                                                {
                                                                    "line":  "CloseMessage",
                                                                    "command":  "CloseMessage"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Use message text that matches healing context."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
