{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.pokemon.party_nickname_dialogue",
    "name":  "Party Nickname Dialogue",
    "description":  "Buffer selected party nickname and show a message with STRVAR output.",
    "category":  "Pokemon",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "bufferId",
                           "label":  "Buffer ID",
                           "type":  "u8",
                           "scrcmdType":  "u8",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  255
                                          }
                       },
                       {
                           "id":  "partySlot",
                           "label":  "Party Slot/Flex",
                           "type":  "variable_id",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  32780,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "messageId",
                           "label":  "Message ID",
                           "type":  "text_id",
                           "scrcmdType":  "u8",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  255
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${bufferId}",
                                 "${partySlot}",
                                 "${messageId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "GenericScriptCommand",
                                                            "Message"
                                                        ],
                              "notes":  "Text buffer helper for Pokemon-specific dialogue lines."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "TextPokeNickname ${bufferId} ${partySlot}",
                                                                    "command":  "TextPokeNickname"
                                                                },
                                                                {
                                                                    "line":  "Message ${messageId}",
                                                                    "command":  "Message"
                                                                },
                                                                {
                                                                    "line":  "WaitButton",
                                                                    "command":  "WaitButton"
                                                                },
                                                                {
                                                                    "line":  "CloseMessage",
                                                                    "command":  "CloseMessage"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Ensure text includes matching STRVAR for the chosen buffer."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv",
                       "textBuffers":  "Documents/Text-Docs/String-Buffers.txt"
                   }
}
