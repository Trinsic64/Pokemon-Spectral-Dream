{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.flow.call_function",
    "name":  "Call Function",
    "description":  "Call a target function and return to caller flow.",
    "category":  "FlowControl",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "functionId",
                           "label":  "Function ID",
                           "type":  "function_id",
                           "scrcmdType":  "FunctionRef",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${functionId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "CallFunction"
                                                        ],
                              "notes":  "Subroutine call pattern."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "Call Function#${functionId}",
                                                                    "command":  "Call"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Target function should usually end with Return."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
