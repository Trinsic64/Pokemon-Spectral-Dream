{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.flow.jumpif_condition",
    "name":  "JumpIf Condition",
    "description":  "Compare variable and jump conditional function.",
    "category":  "FlowControl",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "varId",
                           "label":  "Variable ID",
                           "type":  "variable_id",
                           "scrcmdType":  "Var",
                           "required":  true,
                           "default":  32780,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "value",
                           "label":  "Compare Value",
                           "type":  "u16",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "condition",
                           "label":  "Condition",
                           "type":  "comparison_operator",
                           "scrcmdType":  "u8",
                           "required":  true,
                           "default":  "EQUAL",
                           "validation":  {
                                              "min":  "-1",
                                              "max":  "-1",
                                              "enum":  [
                                                           "EQUAL",
                                                           "DIFFERENT",
                                                           "GREATER",
                                                           "LESS",
                                                           "GREATER/EQUAL",
                                                           "LESS/EQUAL"
                                                       ]
                                          }
                       },
                       {
                           "id":  "functionId",
                           "label":  "Function ID",
                           "type":  "function_id",
                           "scrcmdType":  "FunctionRef",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${varId}",
                                 "${value}",
                                 "${condition}",
                                 "${functionId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "CompareVarValue",
                                                            "JumpIf"
                                                        ],
                              "notes":  "Conditional branch jump."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "CompareVarValue ${varId} ${value}",
                                                                    "command":  "CompareVarValue"
                                                                },
                                                                {
                                                                    "line":  "JumpIf ${condition} Function#${functionId}",
                                                                    "command":  "JumpIf"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "JumpIf does not return to caller."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
