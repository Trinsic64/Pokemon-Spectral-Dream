{
  "schemaVersion": "1.0",
  "templateId": "hgss.greeting.basic",
  "name": "Basic Greeting",
  "description": "Canonical HGSS NPC interaction opener with fanfare, lock, facing, one message, and clean termination.",
  "category": "Greeting",
  "parameters": [
    {
      "id": "scriptId",
      "label": "Script Container ID",
      "type": "container_id",
      "scrcmdType": "container",
      "required": true,
      "default": 1,
      "validation": { "min": 1, "max": 65535 }
    },
    {
      "id": "fanfare",
      "label": "Fanfare",
      "type": "sound_symbol",
      "scrcmdType": "Flex",
      "required": true,
      "default": "SEQ_SE_CONFIRM",
      "uiHint": "Use the confirm interaction fanfare by default."
    },
    {
      "id": "messageId",
      "label": "Message ID",
      "type": "text_id",
      "scrcmdType": "u8",
      "required": true,
      "default": 0,
      "validation": { "min": 0, "max": 255 },
      "uiHint": "Prompt text shown to the player."
    }
  ],
  "requiredPlaceholders": ["${scriptId}", "${fanfare}", "${messageId}"],
  "sceneBlockMapping": {
    "recommendedBlockTypes": ["GreetingBasic", "Message", "ReleaseAndEnd"],
    "notes": "Directly maps to SceneBlockCompiler output for standard talk NPCs."
  },
  "scriptModel": {
    "kind": "full_script",
    "containers": [
      {
        "containerType": "Script",
        "containerId": "${scriptId}",
        "commands": [
          { "line": "PlayFanfare ${fanfare}", "command": "PlayFanfare", "opcode": "0x0049" },
          { "line": "LockAll", "command": "LockAll", "opcode": "0x0060" },
          { "line": "FacePlayer", "command": "FacePlayer", "opcode": "0x0068" },
          { "line": "Message ${messageId}", "command": "Message", "opcode": "0x002D" },
          { "line": "WaitButton", "command": "WaitButton", "opcode": "0x0032" },
          { "line": "CloseMessage", "command": "CloseMessage", "opcode": "0x0035" },
          { "line": "ReleaseAll", "command": "ReleaseAll", "opcode": "0x0061" },
          { "line": "End", "command": "End", "opcode": "0x0002" }
        ]
      }
    ]
  },
  "validationHints": [
    "Message uses u8 slot IDs (0-255).",
    "This template is terminal; do not append additional script lines after End."
  ],
  "references": {
    "scrcmd": "Data/Script-Data/SCRCMD Database - HGSS.csv",
    "corpusExamples": [
      "Data/Script-Data/Scripts/0000.script:Script 1",
      "Data/Script-Data/Scripts/0001.script:Script 1",
      "Data/Script-Data/Scripts/0804.script:Script 1"
    ],
    "sceneEditorSources": [
      "Tools/DSPRE/DS_Map/Editors/Utils/SceneBlockCatalog.cs",
      "Tools/DSPRE/DS_Map/Editors/Utils/SceneBlockCompiler.cs"
    ]
  }
}
