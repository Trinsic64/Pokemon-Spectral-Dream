{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.greeting.silent_no_face",
    "name":  "Silent Greeting No Face",
    "description":  "Lock and message interaction without face-player or fanfare.",
    "category":  "Greeting",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "messageId",
                           "label":  "Message ID",
                           "type":  "text_id",
                           "scrcmdType":  "u8",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  255
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${messageId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "GreetingSilent",
                                                            "Message",
                                                            "ReleaseAndEnd"
                                                        ],
                              "notes":  "Used for ambient objects or non-facing interactions."
                          },
    "scriptModel":  {
                        "kind":  "full_script",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "LockAll",
                                                                    "command":  "LockAll"
                                                                },
                                                                {
                                                                    "line":  "Message ${messageId}",
                                                                    "command":  "Message"
                                                                },
                                                                {
                                                                    "line":  "WaitButton",
                                                                    "command":  "WaitButton"
                                                                },
                                                                {
                                                                    "line":  "CloseMessage",
                                                                    "command":  "CloseMessage"
                                                                },
                                                                {
                                                                    "line":  "ReleaseAll",
                                                                    "command":  "ReleaseAll"
                                                                },
                                                                {
                                                                    "line":  "End",
                                                                    "command":  "End"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Keep this for contexts where forcing face direction is undesirable."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
