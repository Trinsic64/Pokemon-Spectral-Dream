{
  "schemaVersion": "1.0",
  "templateId": "hgss.greeting.flag_conditional",
  "name": "Flag Conditional Greeting",
  "description": "First-time greeting with a persistent flag gate and alternate repeat dialogue branch.",
  "category": "Greeting",
  "parameters": [
    {
      "id": "scriptId",
      "label": "Script Container ID",
      "type": "container_id",
      "scrcmdType": "container",
      "required": true,
      "default": 1,
      "validation": { "min": 1, "max": 65535 }
    },
    {
      "id": "flagId",
      "label": "Story Flag",
      "type": "flag_id",
      "scrcmdType": "u16",
      "required": true,
      "default": 370,
      "validation": { "min": 1, "max": 2558 },
      "uiHint": "Flag set after first interaction."
    },
    {
      "id": "firstMessageId",
      "label": "First-Time Message",
      "type": "text_id",
      "scrcmdType": "u8",
      "required": true,
      "default": 0,
      "validation": { "min": 0, "max": 255 }
    },
    {
      "id": "repeatMessageId",
      "label": "Repeat Message",
      "type": "text_id",
      "scrcmdType": "u8",
      "required": true,
      "default": 1,
      "validation": { "min": 0, "max": 255 }
    },
    {
      "id": "alreadyDoneFunctionId",
      "label": "Repeat Function ID",
      "type": "function_id",
      "scrcmdType": "FunctionRef",
      "required": true,
      "default": 1,
      "validation": { "min": 1, "max": 65535 }
    }
  ],
  "requiredPlaceholders": ["${scriptId}", "${flagId}", "${firstMessageId}", "${repeatMessageId}", "${alreadyDoneFunctionId}"],
  "sceneBlockMapping": {
    "recommendedBlockTypes": ["GreetingBasic", "CheckFlag", "JumpIf", "SetFlag", "Message", "ReleaseAndEnd"],
    "notes": "Matches common one-time reward/dialogue gating in HGSS scripts."
  },
  "scriptModel": {
    "kind": "full_script_with_function",
    "containers": [
      {
        "containerType": "Script",
        "containerId": "${scriptId}",
        "commands": [
          { "line": "PlayFanfare SEQ_SE_CONFIRM", "command": "PlayFanfare", "opcode": "0x0049" },
          { "line": "LockAll", "command": "LockAll", "opcode": "0x0060" },
          { "line": "FacePlayer", "command": "FacePlayer", "opcode": "0x0068" },
          { "line": "CheckFlag ${flagId}", "command": "CheckFlag", "opcode": "0x0020" },
          { "line": "JumpIf EQUAL Function#${alreadyDoneFunctionId}", "command": "JumpIf", "opcode": "0x001C" },
          { "line": "Message ${firstMessageId}", "command": "Message", "opcode": "0x002D" },
          { "line": "WaitButton", "command": "WaitButton", "opcode": "0x0032" },
          { "line": "CloseMessage", "command": "CloseMessage", "opcode": "0x0035" },
          { "line": "SetFlag ${flagId}", "command": "SetFlag", "opcode": "0x001E" },
          { "line": "ReleaseAll", "command": "ReleaseAll", "opcode": "0x0061" },
          { "line": "End", "command": "End", "opcode": "0x0002" }
        ]
      },
      {
        "containerType": "Function",
        "containerId": "${alreadyDoneFunctionId}",
        "commands": [
          { "line": "Message ${repeatMessageId}", "command": "Message", "opcode": "0x002D" },
          { "line": "WaitButton", "command": "WaitButton", "opcode": "0x0032" },
          { "line": "CloseMessage", "command": "CloseMessage", "opcode": "0x0035" },
          { "line": "ReleaseAll", "command": "ReleaseAll", "opcode": "0x0061" },
          { "line": "End", "command": "End", "opcode": "0x0002" }
        ]
      }
    ]
  },
  "validationHints": [
    "Use a dedicated persistent flag per NPC/event branch.",
    "If used in a non-terminal script, replace function End with Return and branch with CallIf."
  ],
  "references": {
    "scrcmd": "Data/Script-Data/SCRCMD Database - HGSS.csv",
    "corpusExamples": [
      "Data/Script-Data/Scripts/0804.script:Script 3 + Function 1",
      "Data/Script-Data/Scripts/0092.script:Script 12"
    ]
  }
}
