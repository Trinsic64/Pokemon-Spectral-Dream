{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.overworld.get_position_branch",
    "name":  "Get OW Position Branch",
    "description":  "Read OW coordinates and branch by expected X value.",
    "category":  "Overworld",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "eventId",
                           "label":  "Event ID",
                           "type":  "overworld_id",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "xVar",
                           "label":  "X Var",
                           "type":  "variable_id",
                           "scrcmdType":  "Var",
                           "required":  true,
                           "default":  16384,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "yVar",
                           "label":  "Y Var",
                           "type":  "variable_id",
                           "scrcmdType":  "Var",
                           "required":  true,
                           "default":  16385,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "expectedX",
                           "label":  "Expected X",
                           "type":  "u16",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "matchFunctionId",
                           "label":  "Match Function",
                           "type":  "function_id",
                           "scrcmdType":  "FunctionRef",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "mismatchFunctionId",
                           "label":  "Mismatch Function",
                           "type":  "function_id",
                           "scrcmdType":  "FunctionRef",
                           "required":  true,
                           "default":  2,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${eventId}",
                                 "${xVar}",
                                 "${yVar}",
                                 "${expectedX}",
                                 "${matchFunctionId}",
                                 "${mismatchFunctionId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "GenericScriptCommand",
                                                            "CompareVarValue",
                                                            "JumpIf",
                                                            "JumpFunction"
                                                        ],
                              "notes":  "Position-aware branch commonly used in map events."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "GetOWPosition ${eventId} ${xVar} ${yVar}",
                                                                    "command":  "GetOWPosition"
                                                                },
                                                                {
                                                                    "line":  "CompareVarValue ${xVar} ${expectedX}",
                                                                    "command":  "CompareVarValue"
                                                                },
                                                                {
                                                                    "line":  "JumpIf EQUAL Function#${matchFunctionId}",
                                                                    "command":  "JumpIf"
                                                                },
                                                                {
                                                                    "line":  "Jump Function#${mismatchFunctionId}",
                                                                    "command":  "Jump"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Coordinate comparisons should use map-local tile values."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv",
                       "corpusExamples":  [
                                              "Data/Script-Data/Scripts/0092.script:Script 2"
                                          ]
                   }
}
