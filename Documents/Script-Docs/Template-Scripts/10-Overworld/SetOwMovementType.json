{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.overworld.set_ow_movement_type",
    "name":  "Set OW Movement Type",
    "description":  "Set default movement type for a target overworld event.",
    "category":  "Overworld",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "eventId",
                           "label":  "Event ID",
                           "type":  "overworld_id",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "movementType",
                           "label":  "Movement Type ID",
                           "type":  "u16",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${eventId}",
                                 "${movementType}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "SetMovementType"
                                                        ],
                              "notes":  "Direct wrapper around SetOWMovement."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "SetOWMovement ${eventId} ${movementType}",
                                                                    "command":  "SetOWMovement"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Movement type values are project-specific behavior IDs."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
