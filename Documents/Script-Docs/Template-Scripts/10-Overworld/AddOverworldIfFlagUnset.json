{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.overworld.add_if_flag_unset",
    "name":  "Add Overworld If Flag Unset",
    "description":  "Check flag, add OW if not active, and set state flag.",
    "category":  "Overworld",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "flagId",
                           "label":  "Flag ID",
                           "type":  "flag_id",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  2558
                                          }
                       },
                       {
                           "id":  "eventId",
                           "label":  "Event ID",
                           "type":  "overworld_id",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "alreadyFunctionId",
                           "label":  "Already Function",
                           "type":  "function_id",
                           "scrcmdType":  "FunctionRef",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${flagId}",
                                 "${eventId}",
                                 "${alreadyFunctionId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "CheckFlag",
                                                            "JumpIf",
                                                            "AddOverworld",
                                                            "SetFlag"
                                                        ],
                              "notes":  "Spawn gate pattern for conditional NPC visibility."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "CheckFlag ${flagId}",
                                                                    "command":  "CheckFlag"
                                                                },
                                                                {
                                                                    "line":  "JumpIf EQUAL Function#${alreadyFunctionId}",
                                                                    "command":  "JumpIf"
                                                                },
                                                                {
                                                                    "line":  "AddOW ${eventId}",
                                                                    "command":  "AddOW"
                                                                },
                                                                {
                                                                    "line":  "SetFlag ${flagId}",
                                                                    "command":  "SetFlag"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Use the same flag/event pair across spawn/despawn templates."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
