{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.overworld.remove_if_flag_set",
    "name":  "Remove Overworld If Flag Set",
    "description":  "Check flag, remove OW if active, and clear state flag.",
    "category":  "Overworld",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "flagId",
                           "label":  "Flag ID",
                           "type":  "flag_id",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  2558
                                          }
                       },
                       {
                           "id":  "eventId",
                           "label":  "Event ID",
                           "type":  "overworld_id",
                           "scrcmdType":  "Flex",
                           "required":  true,
                           "default":  0,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "skipFunctionId",
                           "label":  "Skip Function",
                           "type":  "function_id",
                           "scrcmdType":  "FunctionRef",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${flagId}",
                                 "${eventId}",
                                 "${skipFunctionId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "CheckFlag",
                                                            "JumpIf",
                                                            "RemoveOverworld",
                                                            "ClearFlag"
                                                        ],
                              "notes":  "Despawn gate pattern for conditional NPC visibility."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "CheckFlag ${flagId}",
                                                                    "command":  "CheckFlag"
                                                                },
                                                                {
                                                                    "line":  "JumpIf DIFFERENT Function#${skipFunctionId}",
                                                                    "command":  "JumpIf"
                                                                },
                                                                {
                                                                    "line":  "RemoveOW ${eventId}",
                                                                    "command":  "RemoveOW"
                                                                },
                                                                {
                                                                    "line":  "ClearFlag ${flagId}",
                                                                    "command":  "ClearFlag"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Use DIFFERENT or equivalent token accepted by your parser."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv"
                   }
}
