{
  "schemaVersion": "1.0",
  "templateId": "hgss.misc.custom_unknown_pattern",
  "name": "Custom Unknown Pattern",
  "description": "Round-trip preservation template for unsupported or unknown script lines.",
  "category": "Misc",
  "parameters": [
    {
      "id": "containerSection",
      "label": "Container Section",
      "type": "enum",
      "scrcmdType": "container",
      "required": true,
      "default": "Script",
      "validation": { "enum": ["Script", "Function", "Action"] }
    },
    {
      "id": "containerId",
      "label": "Container ID",
      "type": "container_id",
      "scrcmdType": "container",
      "required": true,
      "default": 1,
      "validation": { "min": 1, "max": 65535 }
    },
    {
      "id": "rawLines",
      "label": "Raw Lines",
      "type": "line_list",
      "scrcmdType": "raw",
      "required": true,
      "default": ["CMD_151", "CMD_257 94"],
      "uiHint": "Lines are emitted exactly as written."
    }
  ],
  "requiredPlaceholders": ["${containerSection}", "${containerId}", "${rawLines}"],
  "sceneBlockMapping": {
    "recommendedBlockTypes": ["CustomUnknown"],
    "notes": "Preserved lines map to SceneDraft.PreservedUnknownLines and are re-emitted by SceneBlockCompiler."
  },
  "scriptModel": {
    "kind": "raw_passthrough",
    "containers": [
      {
        "containerType": "${containerSection}",
        "containerId": "${containerId}",
        "commands": [
          { "line": "${rawLines}" }
        ]
      }
    ]
  },
  "validationHints": [
    "No structural validation beyond non-empty lines.",
    "Use this only when no structured template is suitable."
  ],
  "references": {
    "sceneEditorSources": [
      "Tools/DSPRE/DS_Map/Editors/Utils/SceneBlockParser.cs",
      "Tools/DSPRE/DS_Map/Editors/Utils/SceneBlockCompiler.cs"
    ],
    "corpusExamples": [
      "Data/Script-Data/Scripts/0000.script:CMD_151/CMD_257 usage"
    ]
  }
}
