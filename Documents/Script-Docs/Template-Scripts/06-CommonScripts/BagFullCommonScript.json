{
    "schemaVersion":  "1.0",
    "templateId":  "hgss.common.bag_full",
    "name":  "Bag Full Common Script",
    "description":  "Invoke bag-full common script and terminate.",
    "category":  "CommonScripts",
    "parameters":  [
                       {
                           "id":  "scriptId",
                           "label":  "Script ID",
                           "type":  "container_id",
                           "scrcmdType":  "container",
                           "required":  true,
                           "default":  1,
                           "validation":  {
                                              "min":  1,
                                              "max":  65535
                                          }
                       },
                       {
                           "id":  "commonScriptId",
                           "label":  "Common Script ID",
                           "type":  "common_script_id",
                           "scrcmdType":  "u16",
                           "required":  true,
                           "default":  2009,
                           "validation":  {
                                              "min":  0,
                                              "max":  65535
                                          }
                       }
                   ],
    "requiredPlaceholders":  [
                                 "${scriptId}",
                                 "${commonScriptId}"
                             ],
    "sceneBlockMapping":  {
                              "recommendedBlockTypes":  [
                                                            "GenericScriptCommand"
                                                        ],
                              "notes":  "Standard bag-full feedback helper."
                          },
    "scriptModel":  {
                        "kind":  "snippet",
                        "containers":  [
                                           {
                                               "containerType":  "Script",
                                               "containerId":  "${scriptId}",
                                               "commands":  [
                                                                {
                                                                    "line":  "CommonScript ${commonScriptId}",
                                                                    "command":  "CommonScript"
                                                                },
                                                                {
                                                                    "line":  "End",
                                                                    "command":  "End"
                                                                }
                                                            ]
                                           }
                                       ]
                    },
    "validationHints":  [
                            "Default 2009 corresponds to std_bag_is_full in scriptmacros."
                        ],
    "references":  {
                       "scrcmd":  "Data/Script-Data/SCRCMD Database - HGSS.csv",
                       "commonScriptMacros":  "Tools/hg-engine/armips/include/scriptmacros.s"
                   }
}
