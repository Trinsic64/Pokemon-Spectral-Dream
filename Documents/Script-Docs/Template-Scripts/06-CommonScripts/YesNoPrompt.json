{
  "schemaVersion": "1.0",
  "templateId": "hgss.common.yes_no_prompt",
  "name": "Yes No Prompt",
  "description": "Canonical touchscreen yes/no prompt block with explicit result variable and branch callbacks.",
  "category": "CommonScripts",
  "parameters": [
    {
      "id": "resultVar",
      "label": "Result Variable",
      "type": "variable_id",
      "scrcmdType": "Var",
      "required": true,
      "default": 32780,
      "validation": { "min": 0, "max": 65535 }
    },
    {
      "id": "yesFunctionId",
      "label": "Yes Function ID",
      "type": "function_id",
      "scrcmdType": "FunctionRef",
      "required": true,
      "default": 1,
      "validation": { "min": 1, "max": 65535 }
    },
    {
      "id": "noFunctionId",
      "label": "No Function ID",
      "type": "function_id",
      "scrcmdType": "FunctionRef",
      "required": true,
      "default": 2,
      "validation": { "min": 1, "max": 65535 }
    }
  ],
  "requiredPlaceholders": ["${resultVar}", "${yesFunctionId}", "${noFunctionId}"],
  "sceneBlockMapping": {
    "recommendedBlockTypes": ["YesNoPrompt"],
    "notes": "Matches built-in Scene block pattern and parser recognition."
  },
  "scriptModel": {
    "kind": "snippet_with_functions",
    "containers": [
      {
        "containerType": "Script",
        "containerId": "${scriptId}",
        "commands": [
          { "line": "OpenTouchScreen", "command": "OpenTouchScreen", "opcode": "0x02EA" },
          { "line": "YesNoTouchScreen ${resultVar}", "command": "YesNoTouchScreen", "opcode": "0x02EC" },
          { "line": "CloseTouchScreen", "command": "CloseTouchScreen", "opcode": "0x02EB" },
          { "line": "CompareVarValue ${resultVar} 0", "command": "CompareVarValue", "opcode": "0x0011" },
          { "line": "CallIf EQUAL Function#${yesFunctionId}", "command": "CallIf", "opcode": "0x001D" },
          { "line": "CompareVarValue ${resultVar} 1", "command": "CompareVarValue", "opcode": "0x0011" },
          { "line": "CallIf EQUAL Function#${noFunctionId}", "command": "CallIf", "opcode": "0x001D" }
        ]
      },
      {
        "containerType": "Function",
        "containerId": "${yesFunctionId}",
        "commands": [
          { "line": "Return", "command": "Return", "opcode": "0x001B" }
        ]
      },
      {
        "containerType": "Function",
        "containerId": "${noFunctionId}",
        "commands": [
          { "line": "Return", "command": "Return", "opcode": "0x001B" }
        ]
      }
    ]
  },
  "validationHints": [
    "Result value 0 is Yes and 1 is No in standard HGSS usage.",
    "Add branch behavior inside generated functions or replace with existing targets."
  ],
  "references": {
    "scrcmd": "Data/Script-Data/SCRCMD Database - HGSS.csv",
    "corpusExamples": [
      "Data/Script-Data/Scripts/0000.script:Script 2",
      "Data/Script-Data/Scripts/0092.script:Script 3"
    ],
    "sceneEditorSources": [
      "Tools/DSPRE/DS_Map/Editors/Utils/SceneBlockCompiler.cs"
    ]
  }
}
