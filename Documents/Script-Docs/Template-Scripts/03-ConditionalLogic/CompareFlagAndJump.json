{
  "schemaVersion": "1.0",
  "templateId": "hgss.conditional.compare_flag_and_jump",
  "name": "Compare Flag And Jump",
  "description": "Checks a flag and jumps to one of two function targets.",
  "category": "ConditionalLogic",
  "parameters": [
    {
      "id": "flagId",
      "label": "Flag ID",
      "type": "flag_id",
      "scrcmdType": "u16",
      "required": true,
      "default": 128,
      "validation": { "min": 1, "max": 2558 }
    },
    {
      "id": "ifSetFunctionId",
      "label": "If-Set Function",
      "type": "function_id",
      "scrcmdType": "FunctionRef",
      "required": true,
      "default": 1,
      "validation": { "min": 1, "max": 65535 }
    },
    {
      "id": "ifClearFunctionId",
      "label": "If-Clear Function",
      "type": "function_id",
      "scrcmdType": "FunctionRef",
      "required": true,
      "default": 2,
      "validation": { "min": 1, "max": 65535 }
    }
  ],
  "requiredPlaceholders": ["${flagId}", "${ifSetFunctionId}", "${ifClearFunctionId}"],
  "sceneBlockMapping": {
    "recommendedBlockTypes": ["CheckFlag", "JumpIf", "JumpFunction"],
    "notes": "Base flow-control fragment for one-time events and state splits."
  },
  "scriptModel": {
    "kind": "snippet",
    "containers": [
      {
        "containerType": "Script",
        "containerId": "${scriptId}",
        "commands": [
          { "line": "CheckFlag ${flagId}", "command": "CheckFlag", "opcode": "0x0020" },
          { "line": "JumpIf EQUAL Function#${ifSetFunctionId}", "command": "JumpIf", "opcode": "0x001C" },
          { "line": "Jump Function#${ifClearFunctionId}", "command": "Jump", "opcode": "0x0016" }
        ]
      }
    ]
  },
  "validationHints": [
    "Function IDs must exist or be generated by the caller.",
    "Condition EQUAL is canonical for CheckFlag true branch in HGSS scripts."
  ],
  "references": {
    "scrcmd": "Data/Script-Data/SCRCMD Database - HGSS.csv",
    "corpusExamples": [
      "Data/Script-Data/Scripts/0092.script:Script 11",
      "Data/Script-Data/Scripts/0804.script:Script 3"
    ]
  }
}
